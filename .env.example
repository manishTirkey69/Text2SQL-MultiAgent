# ===========================================
# Database Reasoning Engine Configuration
# ===========================================

# LLM Configuration
LLM__PROVIDER=openai
LLM__MODEL=gpt-4-turbo-preview
LLM__API_KEY=your-openai-api-key-here
LLM__TEMPERATURE=0.0
LLM__MAX_TOKENS=4096
LLM__TIMEOUT=60

# Database Configuration
DB__TYPE=postgresql
DB__HOST=localhost
DB__PORT=5432
DB__DATABASE=your_database
DB__USERNAME=your_username
DB__PASSWORD=your_password
DB__SCHEMA=public

# Safety Configuration
SAFETY__ENFORCE_READONLY=true
SAFETY__MAX_ROWS=10000
SAFETY__TIMEOUT_SECONDS=30
SAFETY__ALLOW_DDL=false
SAFETY__ALLOW_DML=false

# Embedding Configuration
EMBEDDING__MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING__DEVICE=cpu
EMBEDDING__BATCH_SIZE=32

# Memory Configuration
MEMORY__ENABLE_QUERY_MEMORY=true
MEMORY__MAX_HISTORY_TURNS=10
MEMORY__ENABLE_SEMANTIC_BOOSTING=true
MEMORY__EMBEDDING_SIMILARITY_THRESHOLD=0.5

# Federation Configuration
FEDERATION__ENABLE_FEDERATION=false
FEDERATION__MAX_FEDERATED_DATABASES=5
FEDERATION__PARALLEL_EXECUTION=true

# API Configuration
API__HOST=0.0.0.0
API__PORT=8000
API__RELOAD=false
API__WORKERS=1
API__ENABLE_CORS=true

# General Settings
LOG_LEVEL=INFO
ENABLE_REASONING_TRACE=true
DATA_DIR=./data
